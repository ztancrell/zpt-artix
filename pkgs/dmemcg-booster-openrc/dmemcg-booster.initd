#!/usr/bin/openrc-run

supervisor=supervise-daemon
command="/usr/bin/dmemcg-booster"
# The system instance (leaves users' own cgroups alone). The patched daemon uses no D-Bus.
command_args="--use-system-bus"
# Keep the daemon's output, so a failed start or respawn says why.
output_log="/var/log/dmemcg-booster.log"
error_log="/var/log/dmemcg-booster.log"

depend() {
	need cgroups
}
