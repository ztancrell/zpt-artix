#!/usr/bin/openrc-run

# In place of upstream's kait2en-t2-remote.service (Restart=on-failure, RestartSec=2, UMask=0007).
description="KaiT2en T2 AVE service"

supervisor=supervise-daemon
command="/usr/bin/t2remote"
command_args="daemon"
umask=0007
respawn_delay=2
respawn_max=0
output_log="/var/log/kait2en-t2-remote.log"
error_log="/var/log/kait2en-t2-remote.log"

depend() {
	want NetworkManager
	after NetworkManager
}

start_pre() {
	modprobe t2bce_ave || return 1
	# Optional, as upstream's ExecStartPre=-.
	modprobe t2bce_sidecar || :
}
