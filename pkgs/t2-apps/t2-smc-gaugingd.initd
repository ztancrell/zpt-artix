#!/usr/bin/openrc-run

# In place of upstream's t2-smc-gaugingd.service (Restart=on-failure, RestartSec=10).
description="T2 SMC battery gauging mitigation"

supervisor=supervise-daemon
command="/usr/bin/t2-smc-control"
command_args="--daemon"
respawn_delay=10
respawn_max=0
# Keep the daemon's output, so a failed start or respawn says why.
output_log="/var/log/t2-smc-gaugingd.log"
error_log="/var/log/t2-smc-gaugingd.log"
