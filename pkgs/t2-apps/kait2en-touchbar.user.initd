#!/usr/bin/openrc-run

# OpenRC user service in place of upstream's kait2en-touchbar user unit (Restart=on-failure,
# RestartSec=2, at most 5 starts in 30 s). Its sandboxing (ProtectSystem=strict and the like) has no
# OpenRC equivalent and is not carried. Not in any runlevel by default:
# rc-update --user add kait2en-touchbar default
description="T2 Touch Bar"

supervisor=supervise-daemon
command="/usr/bin/kait2en-touchbar"
respawn_delay=2
respawn_max=5
respawn_period=30
