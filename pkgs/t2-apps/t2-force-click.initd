#!/usr/bin/openrc-run

# In place of upstream's t2-force-click.service (Restart=always, RestartSec=2).
description="T2 Force Click daemon"

supervisor=supervise-daemon
command="/usr/bin/t2-force-click"
command_args="--daemon"
respawn_delay=2
respawn_max=0
# Keep the daemon's output, so a failed start or respawn says why.
output_log="/var/log/t2-force-click.log"
error_log="/var/log/t2-force-click.log"

depend() {
	# It finds the active session with loginctl.
	after elogind
}
