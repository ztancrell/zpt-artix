# The Homestead look as system defaults, from homestead's theme/ (the owner's ~/.config made machine-neutral).
# Files in ~/.config override these. /usr/share/icons/default belongs to Artix's default-cursors, so the
# cursor is set by XCURSOR_THEME in /etc/xdg/openbox/environment and by the GTK settings instead.
# Also: a dunst drop-in in /etc/dunst/dunstrc.d (dunst reads /etc/dunst, not /etc/xdg, when XDG_CONFIG_DIRS
# is unset), /etc/xdg/kdeglobals and the Homestead colour scheme for KDE apps.
# Licence: the GTK/Openbox theme and configs are the owner's; KDE-classic's source and licence are unknown;
# six of the eight sounds are sound-theme-freedesktop's files (see its CREDITS), desktop-login.oga and
# device-added.oga are of unknown origin.
pkgname=homestead-theme
_commit=65d57242e7d2cf7fc2e0ab03a0e631eed2322df8
pkgver=r36.g65d5724
pkgrel=1
pkgdesc="Homestead desktop theme and default Openbox, tint2, kitty, obmenu-generator, GTK, dunst and KDE settings"
arch=('any')
url="https://github.com/ztancrell/homestead"
license=('LicenseRef-unknown')
# dex: the autostart runs the XDG autostart entries (tray applets) with it. papirus-icon-theme: the
# Homestead icon theme inherits Papirus-Dark. xed, playerctl (media keys),
# mpv-mpris (pulls mpv; W-m opens mpv, and the plugin lets playerctl control it), brightnessctl and
# libnotify (notify-send, for homestead-osd): rc.xml key bindings; the rest of what autostart and rc.xml run
# comes with zpt-artix-desktop.
depends=('dex' 'papirus-icon-theme' 'ttf-dejavu' 'xcursor-neutral' 'xed' 'playerctl' 'mpv-mpris' 'brightnessctl'
         'libnotify')
optdepends=('zenity: calendar on a click on the tint2 clock'
            'geany: editor for the menu entries that edit the obmenu-generator config')
makedepends=('git')
backup=('etc/gtk-3.0/settings.ini' 'etc/gtk-4.0/settings.ini'
        'etc/xdg/openbox/rc.xml' 'etc/xdg/openbox/menu.xml' 'etc/xdg/openbox/autostart'
        'etc/xdg/openbox/environment' 'etc/xdg/tint2/tint2rc'
        'etc/xdg/kitty/kitty.conf' 'etc/xdg/kitty/homestead.conf'
        'etc/xdg/obmenu-generator/config.pl' 'etc/xdg/obmenu-generator/schema.pl'
        'etc/dunst/dunstrc.d/50-homestead.conf' 'etc/xdg/kdeglobals')
source=("homestead::git+https://github.com/ztancrell/homestead.git#commit=${_commit}")
sha256sums=('SKIP')

pkgver() {
  cd homestead
  printf "r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

package() {
  cd homestead/theme
  install -d "$pkgdir"/usr/share/{themes,icons,homestead} "$pkgdir"/etc/xdg
  cp -r themes/Homestead "$pkgdir"/usr/share/themes/
  cp -r icons/{Homestead,Homestead-Cursor,KDE-classic} "$pkgdir"/usr/share/icons/
  cp -r sounds scripts "$pkgdir"/usr/share/homestead/
  install -Dm644 gtk-3.0/settings.ini "$pkgdir"/etc/gtk-3.0/settings.ini
  install -Dm644 gtk-4.0/settings.ini "$pkgdir"/etc/gtk-4.0/settings.ini
  cp -r openbox tint2 kitty obmenu-generator fastfetch "$pkgdir"/etc/xdg/
  install -Dm644 dunst/50-homestead.conf "$pkgdir"/etc/dunst/dunstrc.d/50-homestead.conf
  install -Dm644 kde/kdeglobals "$pkgdir"/etc/xdg/kdeglobals
  install -Dm644 kde/Homestead.colors "$pkgdir"/usr/share/color-schemes/Homestead.colors
}
