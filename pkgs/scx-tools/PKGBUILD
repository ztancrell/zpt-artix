# Reference: Arch scx-tools 1.1.3-1, without the systemd unit.
pkgname=scx-tools
_gitname=scx-loader
pkgver=1.1.3
pkgrel=2
pkgdesc="scx_loader: a D-Bus interface for managing sched_ext schedulers (with scxctl, scxtui)"
arch=(x86_64)
url="https://github.com/sched-ext/scx-loader"
license=('GPL-2.0-only')
depends=(libgcc glibc polkit)
makedepends=(cargo clang git llvm llvm-libs)
optdepends=('scx-loader-openrc: OpenRC service and D-Bus activation')
options=(!lto)
source=("git+${url}#tag=v${pkgver}")
sha256sums=('da3033733b7bf7d5a9729e31aec2328ebc97d45318726633ed8f83af840f0339')

prepare() {
  cd "$_gitname"
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$_gitname"
  cargo build --release --frozen --all-features --workspace
}

# package_scx-tools, not package: makepkg -s only installs the global depends, and scx-scheds
# lives only in this repo, so it is a runtime dependency set here.
package_scx-tools() {
  depends+=(scx-scheds)
  cd "$_gitname"
  find target/release -maxdepth 1 -type f -executable ! -name '*.so' ! -name xtask \
    -exec install -Dm755 -t "${pkgdir}/usr/bin/" {} +
  # D-Bus policy, interface and activation file, polkit policy, sample config
  ./target/release/xtask install --destdir "$pkgdir"
  rm -r "${pkgdir}/usr/lib/systemd"
  # Its activation file starts a second, unsupervised copy; scx-loader-openrc ships one that
  # hands off to OpenRC.
  rm "${pkgdir}/usr/share/dbus-1/system-services/org.scx.Loader.service"
}
