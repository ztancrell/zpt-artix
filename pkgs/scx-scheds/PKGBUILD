# Reference: Arch scx-scheds 1.1.4-2 (same build; it ships no systemd files).
pkgname=scx-scheds
_gitname=scx
pkgver=1.1.4
pkgrel=1
pkgdesc="sched_ext schedulers and tools"
arch=(x86_64)
url="https://github.com/sched-ext/scx"
license=('GPL-2.0-only')
depends=(bash bpf libgcc glibc jq libseccomp libbpf libelf protobuf zlib)
makedepends=(clang git llvm llvm-libs python rust)
options=(!lto)
source=("git+${url}#tag=v${pkgver}")
sha256sums=('86b19d7667e5d8e6da6bbda6d609db0a1624fb13ad8c845e50684c7efb44f1ba')

prepare() {
  cd "$_gitname"
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$_gitname"
  cargo build --release --frozen --workspace \
    --exclude scx_rlfifo \
    --exclude scx_mitosis \
    --exclude scx_characterize \
    --exclude xtask \
    --exclude vmlinux_docify \
    --exclude scx_arena_selftests \
    --exclude scx_arena_libarena_selftests
}

package() {
  cd "$_gitname"
  find target/release -maxdepth 1 -type f -executable ! -name '*.so' \
    -exec install -Dm755 -t "${pkgdir}/usr/bin/" {} +
}
