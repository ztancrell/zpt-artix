# Reference: AUR bpftune-git as of 2026-11-20 (pkgver r598.688b122-1; not in Arch's repos; unchanged).
# Builds the pinned _commit of oracle-samples/bpftune, never the moving HEAD: an unreviewed upstream
# commit would run in the CI build job and could change any package before signing. To update, review
# the upstream diff, then bump _commit and pkgver. It installs a systemd unit, unused on OpenRC;
# bpftune-openrc (this repo) has the OpenRC service.
# Superseded (2026-11-26): built the newest upstream commit, so pkgver changed with each build.
# Maintainer: Kirill Fries-Raevskiy <exocarnivore@gmail.com>
_pkgbase="bpftune"
_commit=d5d9f609ebe79df5e5788289c4ab51211f57bbef
pkgname="$_pkgbase-git"
pkgver=r772.d5d9f60
pkgrel=1
pkgdesc="BPF/tracing tools for auto-tuning Linux"
arch=("x86_64")
url="https://github.com/oracle/bpftune"
license=('GPLv2 WITH Linux-syscall-note')
#groups=()
depends=("libbpf" "libnl" "libcap")
makedepends=('git' 'bpf' 'clang' 'llvm' 'llvm-libs' 'python-docutils')
provides=("$_pkgbase")
conflicts=("$_pkgbase")
#replaces=()
#backup=()
options=('strip')
#install=
source=("git+https://github.com/oracle-samples/bpftune#commit=${_commit}")
#noextract=()
md5sums=('SKIP')

pkgver() {
	cd "$_pkgbase"
	printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
	cd "$srcdir/$_pkgbase"
	sed -i 's/\/sbin/\/bin/g' src/Makefile
	sed -i 's/\/sbin/\/bin/g' src/bpftune.service
}

build() {
	cd "$srcdir/$_pkgbase"
	CC=clang make libdir=lib
}

package() {
	cd "$srcdir/$_pkgbase"
	CC=clang make DESTDIR="$pkgdir" libdir=lib install
}
