# obsidian-bin and heroic-games-launcher-bin come from this repo: upstream's prebuilt binaries with their
# bundled Electron (Arch's obsidian and AUR heroic-games-launcher need electron43; Artix's newest is
# electron42, checked 2026-11-19). steam is in lib32, which Artix's default pacman.conf leaves off.
# No browser: the owner uses Mozilla's self-updating Firefox Nightly tarball (no Artix package), and the
# Homestead rc.xml binds firefox-nightly. Superseded since 1-5: depends on this repo's firefox-nightly-bin,
# which installs /usr/bin/firefox-nightly (README "CI": nightly.yml rebuilds it daily).
# vkbasalt, simple-mtpfs, jmtpfs, amdtop, python311, libpng12, ocs-url and
# bpftune-git are AUR packages built by this repo. optdepends lists what a stock zpt-artix install can't
# resolve: Arch [extra]/[multilib] packages, and AUR apps this repo doesn't build (see README).
pkgname=zpt-artix-apps
pkgver=1
pkgrel=7
pkgdesc="zpt-artix everyday apps: browser, mail, notes, torrents, music, gaming, dev tools"
arch=('any')
url="https://github.com/ztancrell/zpt-artix"
license=('MIT')
depends=('firefox-nightly-bin' 'thunderbird' 'obsidian-bin' 'qbittorrent' 'mpv'
         'steam' 'lutris' 'heroic-games-launcher-bin' 'mangohud' 'gamemode' 'gamescope' 'protontricks'
         'git' 'github-cli' 'htop' 'fastfetch' 'ripgrep' 'flatpak'
         'lact' 'lact-openrc' 'vkbasalt' 'simple-mtpfs' 'jmtpfs' 'amdtop'
         'python311' 'libpng12' 'ocs-url' 'bpftune-git'
         'zpt-artix-gaming' 'goverlay' 'vkd3d' 'lib32-vkd3d' 'piper' 'solaar')
optdepends=('ghidra: reverse engineering (needs Arch [extra]; see README)'
            'gitea-cli: Gitea command line (needs Arch [extra]; see README)'
            'fsarchiver: filesystem backups (needs Arch [extra]; see README)'
            'efitools: Secure Boot key tools (needs Arch [extra]; see README)'
            'nano-syntax-highlighting: nano syntax files (needs Arch [extra]; see README)'
            'lib32-mangohud: MangoHud for 32-bit games (needs Arch [multilib]; see README)'
            'umu-launcher: Proton launcher outside Steam (needs Arch [multilib]; see README)'
            'antimicrox: map gamepad buttons to keys (needs Arch [extra]; see README)'
            'openrgb: RGB lighting control (needs Arch [extra]; see README)'
            'electron-cash-git: Bitcoin Cash wallet, AUR (needs Arch [extra]; see README)'
            'arch-update: update notifier, AUR (needs Arch [extra]; see README)'
            'bpftune-openrc: OpenRC service for bpftune'
            'lib32-vkbasalt: vkbasalt for 32-bit games, AUR (not built here; see README)'
            'reshade-shaders-git: ReShade shaders for vkbasalt, AUR (not built here; see README)'
            'virtio-win: Windows VirtIO drivers ISO, AUR (not built here; see README)'
            'synergy3-bin: keyboard and mouse sharing, AUR (not built here; see README)')
