#!/usr/bin/openrc-run

# OpenRC user service, from the Artix gaming ISO's dinit user service. Not in any runlevel by default:
# rc-update --user add timidity default
description="TiMidity++ MIDI daemon (ALSA sequencer in, JACK out)"

supervisor=supervise-daemon
command="/usr/bin/timidity"
command_args="-c /etc/timidity/zpt-artix-gaming.cfg -iA -Oj"

depend() {
	need pipewire-pulse
}
